rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Metro transit networks, cities, lines, stations, and fare matrices
    // Read: open to public for instant offline caching
    // Write: open for MetroPulse Admin CMS
    match /cities/{cityId} {
      allow read, write: if true;
      
      match /lines/{lineId} {
        allow read, write: if true;
      }
      
      match /stations/{stationId} {
        allow read, write: if true;
      }
      
      match /fare_matrix/{fareId} {
        allow read, write: if true;
      }
    }

    // Live delay and disruption alerts
    match /service_alerts/{alertId} {
      allow read, write: if true;
    }

    // App monetization & dynamic Prime pricing
    match /app_config/{configId} {
      allow read, write: if true;
    }

    // User entitlements & profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
